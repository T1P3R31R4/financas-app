// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ====================================================
// 1. MULTI-TENANCY & WORKSPACES
// ====================================================
model Family {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  users        User[]
  members      Member[]
  transactions Transaction[]
  categories   Category[]
  activityLogs ActivityLog[]
}

// ====================================================
// 2. AUTENTICAÇÃO (NextAuth) & CONTROLE DE ACESSO
// ====================================================
enum Role {
  ADMIN
  USER
}

model User {
  id            String        @id @default(uuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  password      String?       // Hash bcryptjs (null para usuários OAuth)
  role          Role          @default(USER)

  // Perfil estendido
  phone         String?
  timezone      String?       @default("America/Sao_Paulo")
  currency      String?       @default("BRL")

  familyId      String?
  family        Family?       @relation(fields: [familyId], references: [id], onDelete: SetNull)

  accounts      Account[]
  sessions      Session[]
  activityLogs  ActivityLog[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}


model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ====================================================
// 3. MEMBROS DA FAMÍLIA (MULTI-TENANT)
// ====================================================
enum RelationshipType {
  TITULAR
  CONJUGE
  PAI_MAE
  FILHO
  OUTRO
}

model Member {
  id            String           @id @default(uuid())
  name          String
  avatarUrl     String?
  color         String?
  relationship  RelationshipType @default(OUTRO)
  age           Int?
  isFixedIncome Boolean          @default(true)
  baseSalary    Decimal?         @db.Decimal(12, 2)
  
  familyId      String
  family        Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)

  createdAt     DateTime         @default(now())
  transactions  Transaction[]
}

// ====================================================
// 4. CATEGORIAS DINÂMICAS (GLOBAIS OU POR FAMÍLIA)
// ====================================================
enum CategoryType {
  INCOME
  EXPENSE
}

model Category {
  id           String        @id @default(uuid())
  name         String
  type         CategoryType
  icon         String?
  color        String?

  // familyId nulo indica categoria global disponível a todos os tenants
  familyId     String?
  family       Family?       @relation(fields: [familyId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

// ====================================================
// 5. LANÇAMENTOS FINANCEIROS (MULTI-TENANT)
// ====================================================
enum TransactionType {
  INCOME
  EXPENSE
}

enum StatusType {
  PENDING
  PAID
}

model Transaction {
  id                 String          @id @default(uuid())
  description        String
  amount             Decimal         @db.Decimal(12, 2)
  date               DateTime
  dueDate            DateTime?
  type               TransactionType
  isFixed            Boolean         @default(false)
  status             StatusType
  isHouseholdExpense Boolean         @default(true)
  notes              String?         @db.Text
  
  // Novos campos profissionais
  receiptUrl         String?         // URL do comprovante (Storage / Upload)
  audioNote          String?         @db.Text // Transcrição de áudio via Speech-to-Text
  tags               String[]        @default([]) // Tags para filtros avançados

  memberId           String
  member             Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  categoryId         String
  category           Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  familyId           String
  family             Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// ====================================================
// 6. TELEMETRIA, AUDITORIA & SEGURANÇA (RGPD / LGPD)
// ====================================================
model ActivityLog {
  id        String   @id @default(uuid())
  action    String   // Ex: "CREATE", "UPDATE", "DELETE", "LOGIN", "EXPORT", "BACKUP"
  entity    String   // Ex: "TRANSACTION", "MEMBER", "USER", "FAMILY"
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  familyId  String?
  family    Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  
  ip        String?  // Endereço IP do cliente
  userAgent String?  // Navegador / Dispositivo
  metadata  Json?    // Detalhes da mutação, parâmetros, etc.
  
  createdAt DateTime @default(now())
}
